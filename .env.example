# Copy this file to .env and fill it in before deploying.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
PRIVATE_KEY=YOUR_TEST_WALLET_PRIVATE_KEY

# New collection deploy values.
LAM_BASE_URI=ipfs://METADATA_CID/
LAM_CONTRACT_URI=ipfs://CONTRACT_CID/contract.json
LAM_MINT_PRICE_ETH=0.03

# Sepolia test mint values.
LAM_CONTRACT_ADDRESS=0xYourSepoliaLivingArchiveMachinesContract
LAM_OPENSEA_DROP_CONTRACT_ADDRESS=0xYourMainnetOpenSeaDropContract
LAM_MINT_TO=0xYourTestWallet
LAM_MINT_QUANTITY=1
LAM_USE_PUBLIC_MINT=0

# Token metadata generation. Replace after uploads.
IMAGE_BASE_URI=ipfs://IMAGE_CID
IMAGE_EXTENSION=jpg
ANIMATION_BASE_URI=ipfs://ANIMATION_CID
EXTERNAL_BASE_URL=https://example.com/archive
CUSTOM_STATE_BASE_URI=https://example.com/lam
PART_MANIFEST_URI=ipfs://PART_MANIFEST_CID/part-manifest.json
PALETTE_MANIFEST_URI=ipfs://PALETTE_MANIFEST_CID/lam_special_backgrounds.json
ALIVE_REGISTRY_ADDRESS=TBD_AFTER_DEPLOY

# Collection metadata generation.
LAM_COLLECTION_NAME=Motorheads
LAM_COLLECTION_IMAGE=ipfs://COLLECTION_IMAGE_CID/collection.png
LAM_COLLECTION_BANNER=ipfs://COLLECTION_IMAGE_CID/banner.png
LAM_COLLECTION_EXTERNAL_LINK=https://example.com/archive
LAM_SELLER_FEE_BASIS_POINTS=500
LAM_FEE_RECIPIENT=0x95A6fB3087b3469Ed777120052E0ac3f262c81C1

# Optional upload helpers.
PINATA_JWT=YOUR_PINATA_JWT
FILEBASE_BUCKET=your-filebase-bucket
FILEBASE_ENDPOINT=https://s3.filebase.com
AWS_ACCESS_KEY_ID=YOUR_FILEBASE_KEY
AWS_SECRET_ACCESS_KEY=YOUR_FILEBASE_SECRET

# Production still image capture.
LAM_CAPTURE_FORMAT=jpeg
LAM_CAPTURE_QUALITY=92
LAM_CAPTURE_ENCODER=sharp
LAM_CAPTURE_BATCH=1
LAM_CAPTURE_WORKERS=8
