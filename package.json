{
  "name": "mechanical-canvas-nft",
  "version": "0.1.0",
  "private": true,
  "description": "A commented prototype for a 5555-piece freeform mechanical canvas NFT collection with on-chain machine state and an off-chain builder layout.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "dev": "vite web --host 0.0.0.0",
    "build:web": "vite build web --outDir ../dist-web",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "lam:prototype": "node scripts/render-layers.js && node scripts/generate-animations.js && node scripts/generate-metadata.js",
    "lam:collection": "node scripts/generate-lam-collection.js",
    "lam:layouts": "node scripts/generate-lam-builder-layouts.js",
    "lam:specials": "node scripts/generate-lam-special-visuals.js",
    "lam:validate-traits": "node scripts/validate-lam-traits.js",
    "lam:validate-specials": "node scripts/validate-lam-special-archetypes.js",
    "lam:render": "node scripts/render-layers.js",
    "lam:animations": "node scripts/generate-animations.js",
    "lam:metadata": "node scripts/generate-metadata.js",
    "lam:contract-metadata": "node scripts/generate-lam-contract-metadata.js",
    "lam:validate-opensea": "node scripts/validate-lam-opensea-ready.js",
    "lam:car:images": "node scripts/ensure-ipfs-dir.js && npx --yes ipfs-car pack build/images --output build/ipfs/living-archive-images.car",
    "lam:car:animations": "node scripts/ensure-ipfs-dir.js && npx --yes ipfs-car pack build/animations --output build/ipfs/living-archive-animations.car",
    "lam:car:metadata": "node scripts/ensure-ipfs-dir.js && npx --yes ipfs-car pack build/metadata --output build/ipfs/living-archive-metadata.car",
    "lam:car:contract": "node scripts/ensure-ipfs-dir.js && npx --yes ipfs-car pack build/contract --output build/ipfs/living-archive-contract.car",
    "lam:capture-images": "node scripts/capture-lam-images.js",
    "lam:deploy:local": "hardhat run scripts/deploy-living-archive.js --network localhost",
    "lam:deploy:sepolia": "hardhat run scripts/deploy-living-archive.js --network sepolia",
    "lam:mint:test": "hardhat run scripts/mint-living-archive-test.js --network sepolia",
    "lam:record-sale": "hardhat run scripts/record-sale.js",
    "lam:batch-record-sales": "hardhat run scripts/batch-record-sales.js",
    "lam:set-global-phase": "hardhat run scripts/set-global-phase.js",
    "lam:set-unlock-flag": "hardhat run scripts/set-unlock-flag.js",
    "lam:upload:pinata": "node scripts/upload-pinata.js",
    "lam:upload:filebase": "node scripts/upload-filebase-s3.js",
    "lam:refresh-helper": "node scripts/metadata-refresh-helper.js",
    "parts:starter": "hardhat run scripts/registerStarterParts.js --network localhost",
    "generate": "node scripts/generateCollection.js",
    "upgrade:sepolia": "hardhat run scripts/upgrade.js --network sepolia",
    "upgrade:local": "hardhat run scripts/upgrade.js --network localhost"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@openzeppelin/hardhat-upgrades": "^3.0.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "viem": "^2.55.10",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
